@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Đăng Khoa Sỹ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />


    <style>
        /*#region HEADER */

        header {
            background-color: lightblue;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo img {
            height: 100px;
        }

        .logo h1 {
            margin-left: 10px;
            font-size: 24px;
        }

        nav ul {
            list-style-type: none;
            display: flex;
        }

            nav ul li {
                margin-left: 50px;
            }

                nav ul li a {
                    text-decoration: none;
                    color: black;
                    font-weight: bold;
                    font-size: 25px;
                }
        .menu {
            background-color: aquamarine;
        }
        /*#endregion */



        /*#region BANNER */

        .banner {
            background-image: url('https://img.pikbest.com/backgrounds/20190808/simple-eleven-double-twelve-online-shopping-simple-banner-background_1901192.jpg!sw800');
            background-size: cover;
            background-position: center;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .banner-content {
            text-align: center;
            color: crimson;
        }

            .banner-content h2 {
                font-size: 36px;
                margin-bottom: 20px;
            }

            .banner-content p {
                font-size: 18px;
                margin-bottom: 30px;
            }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            background-color: aqua;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover {
            background-color: darkblue;
        }

        /*#endregion */


        /*#region CONTAINER */
        @*Danh mục sản phẩm*@
        .main-menu ul {
            background-color: hsl(219, 33%, 48%);
            list-style-type: none;
            display: flex;
            justify-content: center;
        }

        .main-menu ul li {
            margin: 0 10px;
        }

        .main-menu ul li a {
            text-decoration: none;
            color: chocolate;
            font-weight: bold;
        }


        @*Sản phẩm nổi bật*@
        .featured-products {
            text-align: center;
            background-color: antiquewhite;
        }

        .featured-products h2 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .product-container {
            display: flex;
            justify-content: center;
            width: 100%;
            gap: 10px;
        }

        .products {
            display: inline-block;
            justify-content: center;
            margin: 5px;
        }

        .product-item {
            width: 250px
        }

        .product-item img {
            width: 100px;
            height: 100px;
        }

        .product-item h3 {
            font-size: 18px;
            margin: 10px 0;
        }

        .product-item .price {
            font-weight: bold;
        }


        @*Danh sách sản phẩm*@
        .product-list {
            background-color: hsl(252, 53%, 78%);
            text-align: center;
        }

        .product-list h2 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .list-container {
            justify-content: center;
            display: flex;
            gap: 20px;
        }

        .product-item {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }

        .product-item img {
            width: 100px;
            height: 100px;
        }

        .product-item h3 {
            font-size: 18px;
            margin: 10px 0;
        }

        .product-item .price {
            font-weight: bold;
        }


        @*Tìm kiếm*@
        .search-section {
            text-align: right;
        }

        .search-section h2 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .search-container {
            display: flex;
            justify-content: right;
            align-items: inherit;
        }

        #search-input {
            width: 300px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px 0 0 5px;
        }

        #serch-button {
            padding: 10px 20px;
            background-color: darkkhaki;
            color: goldenrod;
            border: none;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
        }

        #search-button:hover {
            background-color: crimson;
        }


        @*Giỏ hàng*@
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
        }



        .cart {
            position: relative;
        }

        .fa-shopping-cart {
            font-size: 30px;
        }

        .cart-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: red;
            color: white;
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 50%;
        }
        /*#endregion */

        body {
            background-color: lightgrey;
        }

        footer {
            background-color: black;
            text-align: center;
            color: white;
            padding: 10px;
        }

    </style>


</head>
@*-------------------------------------------------------------------------------------------------------------------------------------------------*@
<body>
